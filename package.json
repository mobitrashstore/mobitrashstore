{
  "name": "mobi-trash-store",
  "private": true,
  "version": "1.3.4",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "android": "next build && npx cap sync && npx cap open android",
    "build:apk": "next build && npx cap sync && cd android && gradlew assembleDebug && echo 'APK Created at: android/app/build/outputs/apk/debug/app-debug.apk'",
    "build:aab": "next build && npx cap sync && cd android && gradlew bundleRelease && echo 'AAB Created at: android/app/build/outputs/bundle/release/app-release.aab'",
    "resources": "npx @capacitor/assets generate --iconBackgroundColor \"#059669\" --splashBackgroundColor \"#059669\" --android",
    "migrate-images": "node scripts/migrate-images-to-cloudinary.js"
  },
  "dependencies": {
    "@capacitor-community/admob": "^5.3.1",
    "@capacitor/android": "^5.0.0",
    "@capacitor/app": "^5.0.8",
    "@capacitor/core": "^5.0.0",
    "@capacitor/push-notifications": "^5.1.2",
    "@capacitor/splash-screen": "^5.0.0",
    "@capacitor/status-bar": "^5.0.0",
    "@emailjs/browser": "^4.4.1",
    "@google-cloud/vision": "^5.3.4",
    "@google/genai": "^0.14.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@vercel/analytics": "^2.0.1",
    "@zxing/library": "^0.21.3",
    "canvas-confetti": "^1.9.3",
    "chart.js": "^4.4.3",
    "cloudinary": "^2.10.0",
    "face-api.js": "^0.22.2",
    "firebase": "^10.12.2",
    "framer-motion": "^12.34.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.564.0",
    "nepali-date-converter": "^3.4.0",
    "next": "^14.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "autoprefixer": "^10.4.19",
    "express": "^5.2.1",
    "postcss": "^8.4.38",
    "puppeteer": "^24.39.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2"
  }
}
