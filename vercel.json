{
  "cleanUrls": true,
  "redirects": [
    { "source": "/(buy|products)/(.*)", "destination": "/product/$2", "permanent": true },
    { "source": "/product/(.*)-i[a-zA-Z0-9_-]+", "destination": "/product/$1", "permanent": true },
    { "source": "/product/(.*)-pk[a-zA-Z0-9_-]+", "destination": "/product/$1", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
